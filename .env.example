# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
APP_NAME=Open Polityra
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
PORT=4000

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql://postgres:password@localhost:5432/open_polityra
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=open_polityra
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

# ==========================================
# AUTHENTICATION
# ==========================================

SESSION_SECRET=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://localhost:6379

# ==========================================
# PYTHON ANALYSIS SERVICE
# ==========================================

ANALYSIS_SERVICE_URL=http://localhost:8000
ANALYSIS_SERVICE_TIMEOUT=120000

# ==========================================
# AI WORKFLOW (Ollama)
# ==========================================

AI_WORKFLOW_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:14b

# ==========================================
# AI PROVIDERS
# ==========================================

AI_PROVIDER=ollama
AI_MODEL=llama3.3
AI_API_KEY=
AI_BASE_URL=http://localhost:11434

# ==========================================
# VECTOR SEARCH
# ==========================================

VECTOR_DATABASE_ENABLED=false
VECTOR_DATABASE_URL=

# ==========================================
# STORAGE
# ==========================================

STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# ==========================================
# EMAIL
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# LOGGING AND MONITORING
# ==========================================

LOG_LEVEL=debug
SENTRY_DSN=

# ==========================================
# FRONTEND
# ==========================================

NEXT_PUBLIC_APP_NAME=Open Polityra
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
