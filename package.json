{
  "name": "open-polityra",
  "version": "0.1.0",
  "private": true,
  "description": "Independent open-source research and strategic intelligence platform.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "turbo run start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "11.0.4"
    }
  }
}
