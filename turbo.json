{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*", "!**/.env.example"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["MONGODB_URI", "GLOBAL_CONFIG", "OLLAMA_MODEL", "OLLAMA_CLOUD_MODEL"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": ["MONGODB_URI", "GLOBAL_CONFIG", "OLLAMA_MODEL", "OLLAMA_CLOUD_MODEL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["MONGODB_URI", "GLOBAL_CONFIG", "OLLAMA_MODEL", "OLLAMA_CLOUD_MODEL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**", "**/.pytest_cache/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
