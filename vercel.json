{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "analysis-worker": {
      "root": "services/analysis-worker",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/news/sync",
      "schedule": "0 0 * * *"
    }
  ]
}
