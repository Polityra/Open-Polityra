FROM python:3.12-slim AS base

WORKDIR /app

COPY services/analysis-worker/pyproject.toml ./pyproject.toml
COPY services/analysis-worker/README.md ./README.md
COPY services/analysis-worker/src ./src

RUN pip install --no-cache-dir pip==24.0 \
    && pip install --no-cache-dir .

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
